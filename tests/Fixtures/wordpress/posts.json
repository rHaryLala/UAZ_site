[{"id":1557,"date":"2026-01-30T11:05:00","date_gmt":"2026-01-30T08:05:00","modified":"2026-07-09T15:39:27","modified_gmt":"2026-07-09T12:39:27","slug":"1557-2","status":"publish","link":"https://zurcher.edu.mg/1557-2/","title":{"rendered":"Janvier 2026 à l’UAZ : Entre Excellence Académique et Lancement de l&rsquo;Année Jubilaire"},"content":{"rendered":"<p><div class=\"et_d4_element et_pb_section et_pb_section_0  et_pb_css_mix_blend_mode et_section_regular et_block_section\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_d4_element et_pb_row et_pb_row_0  et_pb_css_mix_blend_mode et_block_row\">\n\t\t\t\t<div class=\"et_d4_element et_pb_column_4_4 et_pb_column et_pb_column_0  et_pb_css_mix_blend_mode et-last-child et_block_column\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_d4_element et_pb_text et_pb_text_0  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p><span style=\"font-weight: 400;\">L’Université Adventiste Zurcher (UAZ) a entamé l’année 2026 sous le signe de la croissance et de la célébration, marquant officiellement le lancement de son 30</span><span style=\"font-weight: 400;\">e</span><span style=\"font-weight: 400;\"> anniversaire. Ce mois de janvier a été couronné par une étape diplomatique majeure lors d'une visite de courtoisie aux maires d'Ambohibary et d'Antsoatany ainsi qu'à la nouvelle <a href=\"https://www.facebook.com/share/p/17QwGS3NoD/\">Cheffe de la Région Vakinankaratra</a>, scellant ainsi un partenariat stratégique pour le développement régional.</span></p>\n<p><span style=\"font-weight: 400;\">Pendant ce temps, les étudiants de licence, toutes mentions et années confondues, se sont illustrés lors de leurs présentations orales, préparant ainsi avec rigueur les examens finaux de février.</span></p>\n<p><span style=\"font-weight: 400;\">Sur le plan de la vie de campus, l'institution a su conjuguer tradition, hommage et engagement écologique. Le banquet du Nouvel An, organisé le 25 janvier, a été l'occasion de rendre un vibrant hommage au Pasteur Ratsimbason pour son départ à la retraite. Ce moment d'émotion a été complété par une action de reboisement symbolique, fidèle aux valeurs de protection de la Création chères à l'Université. Entre le renforcement des services pour le bien-être des résidents et la ferveur spirituelle des cultes, l'UAZ trace une route solide vers ses trois décennies d'existence.</span></p></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div></p>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":1,"featured_media":1508,"_embedded":{"author":[{"id":1,"name":"uaz","url":"https://zurcher.edu.mg","description":"","link":"https://zurcher.edu.mg/author/uaz/","slug":"uaz","avatar_urls":{"24":"https://secure.gravatar.com/avatar/029745df75837facd42def15e1d5920cdcd7d612024a03e1283cf9bd602d75f4?s=24&d=mm&r=g","48":"https://secure.gravatar.com/avatar/029745df75837facd42def15e1d5920cdcd7d612024a03e1283cf9bd602d75f4?s=48&d=mm&r=g","96":"https://secure.gravatar.com/avatar/029745df75837facd42def15e1d5920cdcd7d612024a03e1283cf9bd602d75f4?s=96&d=mm&r=g"},"_links":{"self":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/users/1","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/users"}]}}],"wp:featuredmedia":[{"id":1508,"date":"2026-01-27T13:44:32","slug":"design-sans-titre-11","type":"attachment","link":"https://zurcher.edu.mg/design-sans-titre-11/","title":{"rendered":""},"author":3,"featured_media":0,"caption":{"rendered":""},"alt_text":"","media_type":"image","mime_type":"image/jpeg","media_details":{"width":2560,"height":1464,"file":"2026/01/Design-sans-titre-11.jpg","filesize":597017,"sizes":{"medium":{"file":"Design-sans-titre-11-300x172.jpg","width":300,"height":172,"filesize":14369,"mime_type":"image/jpeg