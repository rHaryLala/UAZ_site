aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"0","keywords":[],"alt":""},"original_image":"IMG_6538-retouche.png"},"source_url":"https://zurcher.edu.mg/wp-content/uploads/2026/10/IMG_6538-retouche-scaled.png","_links":{"self":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/media/2483","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/media"}],"about":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/types/attachment"}],"author":[{"embeddable":true,"href":"https://zurcher.edu.mg/wp-json/wp/v2/users/4"}],"replies":[{"embeddable":true,"href":"https://zurcher.edu.mg/wp-json/wp/v2/comments?post=2483"}],"wp:attached-to":[{"embeddable":true,"post_type":"post","id":2481,"href":"https://zurcher.edu.mg/wp-json/wp/v2/posts/2481"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}],"wp:term":[[{"id":1,"link":"https://zurcher.edu.mg/category/non-classe/","name":"Non classé","slug":"non-classe","taxonomy":"category","_links":{"self":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/categories/1","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/categories"}],"about":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/taxonomies/category"}],"wp:post_type":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/posts?categories=1"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}],[]]}},{"id":1933,"date":"2026-04-30T09:25:10","date_gmt":"2026-04-30T06:25:10","modified":"2026-07-09T15:39:27","modified_gmt":"2026-07-09T12:39:27","slug":"la-moisson-a-luaz","status":"publish","link":"https://zurcher.edu.mg/la-moisson-a-luaz/","title":{"rendered":"La moisson à l&rsquo;UAZ : une aventure humaine au cœur de nos terres"},"content":{"rendered":"<p><div class=\"et_d4_element et_pb_section et_pb_section_14  et_pb_css_mix_blend_mode et_section_regular et_block_section\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_d4_element et_pb_row et_pb_row_14  et_pb_css_mix_blend_mode et_block_row\">\n\t\t\t\t<div class=\"et_d4_element et_pb_column_4_4 et_pb_column et_pb_column_14  et_pb_css_mix_blend_mode et-last-child et_block_column\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_d4_element et_pb_text et_pb_text_14  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p><span style=\"font-weight: 400;\">Depuis deux semaines, l<span>’effervescence règne sur les terres de notre campus où la moisson du riz pluvial bat son plein. </span> Au-delà de la technique, cette récolte est avant tout une aventure humaine où la solidarité et l'effort collectif se lisent sur chaque visage. Nos équipes travaillent sans relâche pour transformer des mois de patience en une récolte abondante, rappelant que l'engagement et la sueur des hommes restent le cœur battant de notre institution.</span></p>\n<p><span style=\"font-weight: 400;\">Ce succès, qui se construit jour après jour, est le fruit du dévouement sans faille du Département de la Ferme, à qui nous adressons nos remerciements les plus sincères. Leur expertise garantit une production de qualité qui bénéficiera directement à toute notre communauté : </span><i><span style=\"font-weight: 400;\">ce riz est destiné à nourrir notre précieux personnel ainsi que les clients de notre cafétéria</span></i><span style=\"font-weight: 400;\">. En privilégiant ce circuit court, le département assure une alimentation saine et locale pour tous ceux qui font vivre l'université.</span></p>\n<p><span style=\"font-weight: 400;\">Alors que la moisson se poursuit activement, nous nous préparons déjà pour l'étape cruciale du séchage qui suivra. Ces deux semaines de labeur intense témoignent de la force d'une équipe soudée et de notre mission commune d'autonomie alimentaire. Un immense merci à chaque bras fort du Département de la Ferme qui permet à cette saison de se dérouler sous le signe de la gratitude, de la générosité et de l'excellence.</span></p>\n<p><b><i>UAZ – Éduquer pour l'Éternité, Cultiver pour l'Excellence.</i></b></p></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div></p>\n","protected":false},"excerpt":{"rendered":"<p>UAZ – Éduquer pour l&rsquo;Éternité, Cultiver pour l&rsquo;Excellence.</p>\n","protected":false},"author":1,"featured_media":1944,"_embedded":{"author":[{"id":1,"name":"uaz","url":"https://zurcher.edu.mg","description":"","link":"https://zurcher.edu.mg/author/uaz/","slug":"uaz","avatar_urls":{"24":"https://secure.gravatar.com/avatar/029745df75837facd42def15e1d5920cdcd7d612024a03e1283cf9bd602d75f4?s=24&d=mm&r=g","48":"https://secure.gravatar.com/avatar/029745df75837facd42def15e1d5920cdcd7d612024a03e1283cf9bd602d75f4?s=48&d=mm&r=g","96":"https://secure.gravatar.com/avatar/029745df75837facd42def15e1d5920cdcd7d612024a03e1283cf9bd602d75f4?s=96&d=mm&r=g"},"_links":{"self":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/users/1","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://zurcher.edu.mg/wp-json/wp/v2/users"}]}}],"wp:featuredmedia":[{"id":1944,"date":"2026-05-04T13:42:29","slug":"3-3","type":"attachment","link":"https://zurcher.edu.mg/3-3/","title":{"rendered":""},"author":3,"featured_media":0,"caption":{"rendered":""},"alt_text":"","media_type":"image","mime_type":"image/jpeg","media_details":{"width":2560,"height":1707,"file":"2026/05/3.jpg","filesize":500844,"sizes":{"medium":{"file":"3-300x200.jpg","width":300,"height":200,"filesize":15238,"mime_type":"image/jpeg","source_url":"https://zurcher.edu.mg/wp-content/uploads/2026/05/3-300x200.jpg"},"large":{"file":"3-1024x683.jpg","width":1024,"height":683,"filesize":151709,"mime_type":"image/jpeg","source_url":"https://zurcher.edu.mg/wp-content/uploads/2026/05/3-102