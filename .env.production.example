# Modèle de configuration de PRODUCTION (à copier en .env sur le serveur, jamais dans Git).
# Chaque valeur « À DÉFINIR » doit être renseignée avant la mise en ligne.

APP_NAME="Université Adventiste Zurcher"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://zurcher.edu.mg
APP_KEY=                      # À DÉFINIR : php artisan key:generate --force (une seule fois, à conserver précieusement)
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uaz
DB_USERNAME=uaz
DB_PASSWORD=                  # À DÉFINIR : mot de passe long et unique

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database     # nécessite le worker (voir docs/DEPLOIEMENT.md)
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=                    # À DÉFINIR : serveur SMTP
MAIL_PORT=587
MAIL_USERNAME=                # À DÉFINIR
MAIL_PASSWORD=                # À DÉFINIR
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=            # À DÉFINIR : ex. no-reply@zurcher.edu.mg
MAIL_FROM_NAME="${APP_NAME}"

# --- Spécifique au site ---
CONTACT_RECIPIENT=            # À DÉFINIR : adresse qui reçoit les messages du formulaire de contact
MEDIA_MAX_FILE_SIZE_KB=10240
MEDIA_AVIF=true
# Compte super-admin créé UNE fois par le seeder ; laisser vide pour ne rien créer (puis `php artisan make:filament-user`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
